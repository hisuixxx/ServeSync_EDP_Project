NODE_ENV=production
PORT=3000
APP_URL=https://your-servesync-domain.example
SESSION_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ServeSync_E-Commerce_Atienza
DB_USER=your-database-user
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-configured-gmail@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=your-configured-gmail@gmail.com
MAIL_FROM_NAME="ServeSync Restaurant"

GCASH_ACCOUNT_NAME=ServeSync Gcash
GCASH_NUMBER=
GCASH_QR_IMAGE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-servesync-domain.example/auth/google/callback
