{{> head}}
<body class="servesync-body">
  {{> head}}
  <main class="servesync-shell servesync-auth-page">
    <form class="servesync-auth-card" method="POST" action="/login">
      <div class="servesync-kicker">Welcome back</div>
      <h1>Sign in to ServeSync.</h1>
      <p>Pick up where you left off and keep your next order close.</p>
      <label class="servesync-form-field">Email
        <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
      </label>
      <label class="servesync-form-field">Password
        <input type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required />
      </label>
      <button class="servesync-button servesync-button-primary servesync-button-wide" type="submit">Sign In</button>
      <p class="servesync-auth-switch">New to ServeSync? <a href="/register">Create an account</a></p>
    </form>
  </main>
{{> footer }}