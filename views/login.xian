{{> head }}
<body class="servesync-body auth-page">
  <header class="auth-header servesync-shell">
    <span class="servesync-logo" aria-label="ServeSync">ServeSync</span>
    <a class="auth-home-link" href="/">← Back to Home</a>
  </header>
  <main class="servesync-shell servesync-auth-page">
    {{> flash-messages}}
    <form class="servesync-auth-card" method="POST" action="/login">
      <div class="servesync-kicker">Welcome back</div>
      <h1>Sign in to ServeSync.</h1>
      <p>Pick up where you left off and keep your next order close.</p>
      {{#if authMessage}}<p class="servesync-form-error" role="alert">{{ authMessage }}</p>{{/if}}
      {{#if error}}<p class="servesync-form-error" role="alert">{{ error }}</p>{{/if}}
      <input type="hidden" name="returnTo" value="{{ returnTo }}" />
      <label class="servesync-form-field">Email Address
        <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
      </label>
      <label class="servesync-form-field">Password
        <span class="auth-password-wrap"><input id="login-password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required /><button class="auth-password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false">Show</button></span>
      </label>
      <div class="auth-form-options"><a href="/forgot-password">Forgot password?</a></div>
      <button class="servesync-button servesync-button-primary servesync-button-wide" type="submit">Login</button>
      <div class="servesync-auth-divider" role="separator"><span>or</span></div>
      <a class="servesync-google-button" href="/auth/google?source=login">
        <span class="servesync-google-mark" aria-hidden="true">G</span>
        <span>Continue with Google</span>
      </a>
      {{#unless googleConfigured}}<p class="servesync-google-setup">Google sign-in is unavailable until the administrator configures OAuth credentials.</p>{{/unless}}
    </form>
  </main>
  <script src="/js/auth.js" defer></script>
{{> footer }}
