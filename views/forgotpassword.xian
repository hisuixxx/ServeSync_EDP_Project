{{> head }}
<body class="servesync-body">
  {{> header}}
  <main class="servesync-shell servesync-page">
    <section class="ss-panel">
      <span class="servesync-kicker">ACCOUNT RECOVERY</span>
      <h1>Forgot your password?</h1>
      <p>
        For account security, contact the ServeSync administrator and request a password reset. 
        The administrator can set a temporary password from User Management.
      </p>
      <p>
        After signing in with the temporary password, open your Profile page and change it immediately.
      </p>
      <a class="servesync-button servesync-button-primary" href="/login">Back to Login</a>
    </section>
  </main>
{{> footer }}