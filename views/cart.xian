{{> head }}
<body class="servesync-body">
  {{> header }}
  <main class="servesync-shell servesync-page">
    <div class="servesync-page-heading">
      <div>
        <div class="servesync-kicker">Your cart</div>
        <h1>Ready when you are.</h1>
      </div>
      <p>Review your dishes, adjust quantities, and continue when you're ready.</p>
    </div>
    {{#if success_msg}}<div class="servesync-notice servesync-order-success" role="status">{{ success_msg }}</div>{{/if}}
    {{#if error_msg}}<div class="servesync-form-error" role="alert">{{ error_msg }}</div>{{/if}}
    {{#if error}}<div class="servesync-form-error" role="alert">{{ error }}</div>{{/if}}
    {{#if orderConfirmation}}
      <div class="servesync-notice servesync-order-success" role="status">{{ orderConfirmation }}</div>
    {{/if}}
    {{#if cart.length}}
      <div class="servesync-cart-list">
        {{#each cart}}
          <article class="servesync-cart-item">
            <div class="servesync-cart-product">
              <a class="servesync-cart-image" href="/menu/{{ product_id }}" aria-label="View {{ product_name }}">
                {{#if product_image}}
                  <img src="{{ product_image }}" alt="{{ product_name }}" loading="lazy" />
                {{else}}
                  <span class="servesync-card-placeholder" aria-hidden="true">S</span>
                {{/if}}
              </a>
              <div class="servesync-cart-product-info">
                {{#if category_name}}<div class="servesync-card-category">{{ category_name }}</div>{{/if}}
                <h2>{{ product_name }}</h2>
                <p>Unit price: &#8369;{{ price }}</p>
                {{#unless productAvailable}}<p class="servesync-unavailable">Currently unavailable. Remove this item to proceed.</p>{{/unless}}
              </div>
            </div>
            <div class="servesync-cart-item-controls">
              <div class="servesync-cart-quantity" aria-label="Quantity: {{ quantity }}">
                <form method="POST" action="/cart/items/{{ id }}/decrease">
                  <button class="servesync-quantity-button" type="submit" aria-label="Decrease {{ product_name }} quantity">&#8722;</button>
                </form>
                <span>{{ quantity }}</span>
                <form method="POST" action="/cart/items/{{ id }}/increase">
                  <button class="servesync-quantity-button" type="submit" aria-label="Increase {{ product_name }} quantity">&#43;</button>
                </form>
              </div>
              <div class="servesync-cart-item-subtotal">
                <span>Subtotal</span>
                <strong>&#8369;{{ lineTotal }}</strong>
              </div>
              <form method="POST" action="/cart/items/{{ id }}/remove">
                <button class="servesync-remove-button" type="submit">Remove</button>
              </form>
            </div>
          </article>
        {{/each}}
      </div>
      <div class="servesync-cart-summary">
        <div>
          <span>Total</span>
          <strong>&#8369;{{ cartTotal }}</strong>
        </div>
        <div class="servesync-detail-actions">
          <a class="servesync-button servesync-button-ghost" href="/menu">Continue browsing</a>
          {{#if canProceed}}
            <a class="servesync-button servesync-button-primary" href="/checkout">Proceed to Order</a>
          {{else}}
            <button class="servesync-button servesync-button-primary" type="button" disabled>Proceed to Order</button>
          {{/if}}
        </div>
      </div>
    {{else}}
      <div class="servesync-notice">
        <p>Your cart is empty. Explore the menu to get started.</p>
        <a class="servesync-button servesync-button-primary" href="/menu">Explore menu</a>
      </div>
    {{/if}}
  </main>
  {{> footer }}