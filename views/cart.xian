{{> head }}
<body class="servesync-body">
  {{> header }}
  <main class="servesync-shell servesync-page">
    <div class="servesync-page-heading">
      <div>
        <div class="servesync-kicker">Your cart</div>
        <h1>Ready when you are.</h1>
      </div>
      <p>Review your selected dishes and quantities before proceeding.</p>
    </div>
    {{#if orderConfirmation}}
      <div class="servesync-notice servesync-order-success" role="status">{{ orderConfirmation }}</div>
    {{/if}}
    {{#if cartMessage}}
      <div class="servesync-cart-message servesync-cart-message-{{ cartMessageType }}" role="status">{{ cartMessage }}</div>
    {{/if}}
    {{#if cart.length}}
      <div class="servesync-cart-list">
        {{#each cart}}
          <article class="servesync-cart-item">
            <div class="servesync-cart-product">
              <div class="servesync-cart-image">
                {{#if product_image}}
                  <img src="{{ product_image }}" alt="{{ product_name }}" />
                {{else}}
                  <span class="servesync-card-placeholder" aria-hidden="true">Dish</span>
                {{/if}}
              </div>
              <div class="servesync-cart-product-details">
                {{#if category_name}}<div class="servesync-card-category">{{ category_name }}</div>{{/if}}
                <h2>{{ product_name }}</h2>
                <p>Unit price: &#8369;{{ price }}</p>
              </div>
            </div>
            <div class="servesync-cart-quantity" aria-label="Quantity controls for {{ product_name }}">
              <form method="POST" action="/cart/items/{{ id }}/decrease">
                <button class="servesync-quantity-button" type="submit" aria-label="Decrease {{ product_name }} quantity" {{#unless canDecrease}}disabled{{/unless}}>&minus;</button>
              </form>
              <span>{{ quantity }}</span>
              <form method="POST" action="/cart/items/{{ id }}/increase">
                <button class="servesync-quantity-button" type="submit" aria-label="Increase {{ product_name }} quantity">+</button>
              </form>
            </div>
            <div class="servesync-cart-line-total">
              <span>Subtotal</span>
              <strong>&#8369;{{ lineTotal }}</strong>
            </div>
            <form method="POST" action="/cart/items/{{ id }}/remove">
              <button class="servesync-cart-remove" type="submit">Remove</button>
            </form>
          </article>
        {{/each}}
      </div>
      <div class="servesync-cart-summary">
        <div>
          <span>Total</span>
          <strong>&#8369;{{ cartTotal }}</strong>
        </div>
        <div class="servesync-detail-actions">
          <a class="servesync-button servesync-button-ghost" href="/menu">Continue browsing</a>
          <form method="POST" action="/cart/order">
            <button class="servesync-button servesync-button-primary" type="submit">Proceed to Buy</button>
          </form>
        </div>
      </div>
    {{else}}
      <div class="servesync-notice">
        <p>Your cart is empty. Explore the menu to get started.</p>
        <a class="servesync-button servesync-button-primary" href="/menu">Explore menu</a>
      </div>
    {{/if}}
  </main>
  {{> footer }}
