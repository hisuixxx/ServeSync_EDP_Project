{{> head }}
<body class="servesync-body">
  {{#if isCustomer}}
  <div class="ss-admin-layout">
    {{> admin-sidebar}}
    <main class="ss-admin-main servesync-shell servesync-page">
  {{else}}
  {{> header}}
  <main class="servesync-shell servesync-page">
  {{/if}}
    {{> flash-messages}}
    <header class="servesync-page-heading">
      <div>
        <span class="servesync-kicker">SERVESYNC MENU</span>
        <h1>Explore our menu</h1>
        <p>Freshly prepared favorites, with clear descriptions and prices.</p>
      </div>
      {{#unless isCustomer}}
        <div class="ss-menu-requests">
          <a href="/request/catering">Request Catering</a>
          <a href="/request/delivery">Request Delivery</a>
        </div>
      {{/unless}}
    </header>
    {{#if menuError}}
    <p class="servesync-notice">{{menuError}}</p>
    {{/if}}
    <form method="get" action="/menu" class="ss-menu-filter">
      <input name="search" value="{{search}}" placeholder="Search dishes">
      <select name="category"><option value="">All categories</option>
        {{#each categories}}
        <option value="{{id}}">
          {{category_name}}
        </option>
        {{/each}}
      </select>
      <button class="ss-small-button">Search</button>
    </form>
    <section class="servesync-menu-grid">
      {{#each products}}
      <a class="servesync-menu-card" href="/menu/{{id}}">
        {{#if image}}
        <img src="{{image}}" alt="{{product_name}}">
        {{else}}
        <div class="ss-product-placeholder">ServeSync</div>
        {{/if}}
        <div>
          <small>
            {{category.category_name}}
          </small>
          <h2>{{product_name}}</h2>
          <p>{{description}}</p>
          <strong>₱{{price}}</strong>
        </div>
      </a>
      {{else}}
      <p>No menu items are currently available.</p>
      {{/each}}
    </section>
  </main>
  {{#if isCustomer}}</div>{{/if}}
  {{> footer }}
 
