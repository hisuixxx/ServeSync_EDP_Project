{{> head }}
<body class="servesync-body">
  <div class="ss-admin-layout">
    {{> admin-sidebar}}

    <main class="ss-admin-main">
      {{> flash-messages}}

      <h1>Product Management</h1>

      <section class="ss-panel">
        <h2>Add Product</h2>
        <form method="post" action="/staff/products" enctype="multipart/form-data" class="ss-form-grid">
          <label>Name
            <input name="product_name" required>
          </label>
          <label>Category
            <select name="category_id">
              {{#each categories}}
                <option value="{{id}}">{{category_name}}</option>
              {{/each}}
            </select>
          </label>
          <label>Price
            <input name="price" type="number" min="0.01" step="0.01" required>
          </label>
          <label>Product image
            <input name="imageFile" type="file" accept="image/jpeg,image/png,image/webp">
          </label>
          <label>Or image URL
            <input name="image" type="url">
          </label>
          <label class="ss-wide">Description
            <textarea name="description"></textarea>
          </label>
          <label>
            <input type="checkbox" name="availability" checked> Available
          </label>
          <button class="servesync-button servesync-button-primary">Add Product</button>
        </form>
      </section>

      <section class="ss-panel">
        <h2>Edit Products</h2>
        <div class="ss-table-wrap">
          <table class="ss-table" data-table>
            <thead>
              <tr>
                <th>Product</th>
                <th>Category ID</th>
                <th>Price</th>
                <th>Availability</th>
                <th>Save</th>
              </tr>
            </thead>
            <tbody>
              {{#each products}}
                <tr>
                  <td colspan="5">
                    <form method="post" action="/staff/products/{{id}}/update" enctype="multipart/form-data" class="ss-inline-edit">
                      <input name="product_name" value="{{product_name}}">
                      <input name="category_id" type="number" value="{{category_id}}">
                      <input name="price" type="number" step="0.01" value="{{price}}">
                      <input name="image" type="url" value="{{image}}" placeholder="Image URL">
                      <label>
                        <input type="checkbox" name="availability" {{#if availability}}checked{{/if}}> Available
                      </label>
                      <button class="ss-small-button">Save</button>
                    </form>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="5">No products.</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <p class="ss-muted">Staff can add and edit products but cannot archive or delete them.</p>
      </section>
    </main>
  </div>
  <script src="/js/admin.js"></script>
{{> footer }}
