{{> head }}
<body class="servesync-body">
  <div class="ss-admin-layout">
    {{> admin-sidebar}}
    <main class="ss-admin-main">
      {{> flash-messages}}
      
      <header class="ss-admin-top">
        <div>
          <span class="servesync-kicker">CATALOG</span>
          <h1>Product Management</h1>
        </div>
        <a class="servesync-button servesync-button-primary" href="/admin/archive">Open Archive</a>
      </header>

      <section class="ss-panel">
        <h2>Add Product</h2>
        <form method="post" action="/admin/products" enctype="multipart/form-data" class="ss-form-grid">
          <label>Product name
            <input name="product_name" required maxlength="150">
          </label>
          <label>Category
            <select name="category_id" required>
              {{#each categories}}
              <option value="{{id}}">{{category_name}}</option>
              {{/each}}
            </select>
          </label>
          <label>Price (PHP)
            <input type="number" name="price" min="0.01" step="0.01" required>
          </label>
          <label>Product image
            <input name="imageFile" type="file" accept="image/jpeg,image/png,image/webp">
          </label>
          <label>Or image URL
            <input name="image" type="url" placeholder="https://...">
          </label>
          <label class="ss-wide">Description
            <textarea name="description"></textarea>
          </label>
          <label>
            <input type="checkbox" name="availability" checked> Available
          </label>
          <button class="servesync-button servesync-button-primary">Add Product</button>
        </form>
      </section>

      <section class="ss-panel">
        <h2>Active Products</h2>
        <form method="get" action="/admin/products">
          <input name="search" value="{{search}}" placeholder="Search product name or description">
          <button class="ss-small-button">Search</button>
        </form>
        
        <div class="ss-table-wrap">
          <table class="ss-table" data-table>
            <thead>
              <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Availability</th>
                <th>Update</th>
                <th>Archive</th>
              </tr>
            </thead>
            <tbody>
              {{#each products}}
              <tr>
                <td>{{product_name}}</td>
                <td>{{category.category_name}}</td>
                <td>₱{{price}}</td>
                <td>
                  {{#if availability}}Available{{else}}Unavailable{{/if}}
                </td>
                <td>
                  <details>
                    <summary>Edit</summary>
                    <form method="post" action="/admin/products/{{id}}/update" enctype="multipart/form-data" class="ss-edit-form">
                      <label>Name
                        <input name="product_name" value="{{product_name}}" required>
                      </label>
                      <label>Category ID
                        <input name="category_id" type="number" value="{{category_id}}" required>
                      </label>
                      <label>Price
                        <input name="price" type="number" min="0.01" step="0.01" value="{{price}}" required>
                      </label>
                      <label>New image
                        <input name="imageFile" type="file" accept="image/jpeg,image/png,image/webp">
                      </label>
                      <label>Image URL
                        <input name="image" type="url" value="{{image}}">
                      </label>
                      <label>Description
                        <textarea name="description">{{description}}</textarea>
                      </label>
                      <label>
                        <input type="checkbox" name="availability" {{#if availability}}checked{{/if}}> Available
                      </label>
                      <button class="ss-small-button">Save</button>
                    </form>
                  </details>
                </td>
                <td>
                  <form method="post" action="/admin/products/{{id}}/archive" onsubmit="return confirm('Archive this product?')">
                    <button class="ss-small-button ss-danger">Archive</button>
                  </form>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6">No active products found.</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="ss-table-pager">
          {{#if hasPrev}}
          <a class="ss-small-button" href="/admin/products?page={{prevPage}}&search={{search}}">Previous</a>
          {{/if}}
          <span>Page {{page}} of {{pages}}</span>
          {{#if hasNext}}
          <a class="ss-small-button" href="/admin/products?page={{nextPage}}&search={{search}}">Next</a>
          {{/if}}
        </div>
      </section>
    </main>
  </div>
  <script src="/js/admin.js"></script>
{{> footer }}