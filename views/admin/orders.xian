{{> head }}
<body class="servesync-body">
<div class="ss-admin-layout">
  {{> admin-sidebar}}
  <main class="ss-admin-main">
    {{> admin-topbar adminSection="ORDER MANAGEMENT" adminPageTitle="Orders"}}
    {{> flash-messages}}
    <p class="ss-admin-page-action"><a class="servesync-button servesync-button-ghost" href="/admin/payments">Payment Verification</a></p>

    <section class="ss-panel">
      <h2>Orders</h2>
      <form method="get" class="ss-order-filter-form">
        <label>Status
          <select name="status">
            <option value="" {{#unless selectedStatus}}selected{{/unless}}>All statuses</option>
            <option value="pending" {{#if (eq selectedStatus "pending")}}selected{{/if}}>Pending</option>
            <option value="approved" {{#if (eq selectedStatus "approved")}}selected{{/if}}>Approved</option>
            <option value="preparing" {{#if (eq selectedStatus "preparing")}}selected{{/if}}>Preparing</option>
            <option value="ready" {{#if (eq selectedStatus "ready")}}selected{{/if}}>Ready</option>
            <option value="out_for_delivery" {{#if (eq selectedStatus "out_for_delivery")}}selected{{/if}}>Out for delivery</option>
            <option value="completed" {{#if (eq selectedStatus "completed")}}selected{{/if}}>Completed</option>
            <option value="rejected" {{#if (eq selectedStatus "rejected")}}selected{{/if}}>Rejected</option>
            <option value="cancelled" {{#if (eq selectedStatus "cancelled")}}selected{{/if}}>Cancelled</option>
          </select>
        </label>
        <button class="ss-small-button" type="submit">Filter</button>
      </form>
      <div class="ss-table-wrap">
        <table class="ss-table" data-table>
          <thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th>Actions</th></tr></thead>
          <tbody>
            {{#each orders}}
            <tr>
              <td>{{order_number}}</td>
              <td>{{customer.full_name}}<br><small>{{customer.email}}</small></td>
              <td>PHP {{total_amount}}</td>
              <td>{{payment.methodLabel}} · {{payment.statusLabel}}</td>
              <td>{{status}}</td>
              <td><button class="ss-small-button ss-secondary" type="button" data-modal-open="admin-order-{{id}}">View / update</button></td>
            </tr>
            {{else}}<tr><td colspan="6">No orders found.</td></tr>{{/each}}
          </tbody>
        </table>
      </div>
    </section>

    {{#each orders}}
    <div class="servesync-modal ss-order-detail-modal" id="admin-order-{{id}}" hidden aria-hidden="true">
      <div class="servesync-modal-backdrop" data-modal-close="admin-order-{{id}}"></div>
      <section class="servesync-modal-card" role="dialog" aria-modal="true" aria-labelledby="admin-order-title-{{id}}">
        <button class="servesync-modal-close" type="button" aria-label="Close order details" data-modal-close="admin-order-{{id}}">&times;</button>
        <span class="servesync-kicker">ORDER MANAGEMENT · {{status}}</span>
        <h2 id="admin-order-title-{{id}}">{{order_number}}</h2>
        <dl class="servesync-request-details">
          <div><dt>Customer</dt><dd>{{customer.full_name}} · {{customer.email}}</dd></div>
          <div><dt>Contact</dt><dd>{{customer.phone}}</dd></div>
          <div><dt>Order type</dt><dd>{{order_type}}</dd></div>
          {{#if delivery_address}}<div><dt>Delivery address</dt><dd>{{delivery_address}}</dd></div>{{/if}}
          <div><dt>Payment</dt><dd>{{payment.methodLabel}} · {{payment.statusLabel}}{{#if payment.reference_code}} · Ref {{payment.reference_code}}{{/if}}</dd></div>
          <div><dt>Total</dt><dd>PHP {{total_amount}}</dd></div>
          {{#if notes}}<div><dt>Special instructions</dt><dd>{{notes}}</dd></div>{{/if}}
        </dl>
        <h3>Items</h3>
        <div class="ss-table-wrap"><table class="ss-table ss-modal-items-table"><thead><tr><th>Item</th><th>Qty</th><th>Subtotal</th></tr></thead><tbody>
          {{#each items}}<tr><td>{{product_name}}</td><td>{{quantity}}</td><td>PHP {{subtotal}}</td></tr>{{/each}}
        </tbody></table></div>
        {{#if canUpdate}}
        <form class="ss-order-status-form" method="post" action="/admin/orders/{{id}}/status">
          <input type="hidden" name="returnTo" value="/admin/orders">
          <label>Next order status<select name="status" required>{{#each statusOptions}}<option value="{{value}}">{{label}}</option>{{/each}}</select></label>
          <div class="ss-modal-actions"><button class="servesync-button servesync-button-primary" type="submit">Update order</button><button class="servesync-button servesync-button-ghost" type="button" data-modal-close="admin-order-{{id}}">Cancel</button></div>
        </form>
        {{else}}
        <p class="ss-muted">No further status changes are available for this order.</p>
        <div class="ss-modal-actions"><button class="servesync-button servesync-button-ghost" type="button" data-modal-close="admin-order-{{id}}">Close</button></div>
        {{/if}}
      </section>
    </div>
    {{/each}}
  </main>
</div>
<script src="/js/admin.js" defer></script>
{{> footer }}
