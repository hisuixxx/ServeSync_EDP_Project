{{> head }}
<body class="servesync-body">
  {{> header}}
  <main class="servesync-shell servesync-page">
    <section class="servesync-notice">
      <div class="servesync-kicker">SERVESYNC</div>
      <h1>
        {{#if message}}
        {{message}}
        {{else}}Page not found{{/if}}</h1>
        
        <p>
          {{#if errorDescription}}
          {{errorDescription}}
          {{else}}The page may have moved, the item may be unavailable, or you may not have permission to view it.{{/if}}</p>
          <a class="servesync-button servesync-button-primary" href="/menu">Return to menu</a>
        </section>
      
      </main>
      {{> footer }}
