{{> head }}
<body class="servesync-body">
  <main class="servesync-shell">
    <header class="servesync-header">
      <a class="servesync-logo" href="/">ServeSync</a>
      <nav>
        <a href="/register">Create Account</a>
        <a href="/login">Login</a>
      </nav>
    </header>

    <section class="ss-hero">
      <span class="servesync-kicker">DIGITAL MENU &amp; ORDERING</span>
      <h1>Good food.<br>Easy ordering.</h1>
      <p>Discover your next favorite meal, browse our menu, and order from the comfort of your home.</p>
      <a class="servesync-button servesync-button-primary" href="/menu">Explore Menu →</a>
    </section>
  </main>
{{> footer }}