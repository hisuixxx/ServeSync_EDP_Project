{{> head }}
<body class="servesync-body">
  {{> header }}
  <main class="servesync-shell servesync-page">
    <div class="servesync-page-heading">
      <div>
        <div class="servesync-kicker">Checkout</div>
        <h1>Review your order.</h1>
      </div>
      <p>Confirm your items and delivery details, then pay using GCash. Payment is verified manually by ServeSync.</p>
    </div>

    {{#if error_msg}}<div class="servesync-form-error" role="alert">{{ error_msg }}</div>{{/if}}

    <section class="servesync-checkout-section" aria-labelledby="checkout-items-title">
      <h2 id="checkout-items-title">Your items</h2>
      <div class="servesync-cart-list">
        {{#each items}}
          <article class="servesync-cart-item">
            <div class="servesync-cart-product">
              <div class="servesync-cart-image">
                {{#if product_image}}
                  <img src="{{ product_image }}" alt="{{ product_name }}" />
                {{else}}
                  <span class="servesync-card-placeholder" aria-hidden="true">S</span>
                {{/if}}
              </div>
              <div class="servesync-cart-product-info">
                <h2>{{ product_name }}</h2>
                <p>Quantity: {{ quantity }}</p>
                <p>Each: &#8369;{{ unitPrice }}</p>
              </div>
            </div>
            <div class="servesync-cart-item-subtotal">
              <span>Subtotal</span>
              <strong>&#8369;{{ subtotal }}</strong>
            </div>
          </article>
        {{/each}}
      </div>
      <div class="servesync-checkout-total">
        <span>Total amount to pay</span>
        <strong>&#8369;{{ total }}</strong>
      </div>
    </section>

    {{#unless available}}
      <div class="servesync-form-error" role="alert">One or more items are no longer available. Return to your cart to remove them before ordering.</div>
    {{/unless}}

    <form class="servesync-checkout-form" method="POST" action="/checkout">
      <input type="hidden" name="quoteToken" value="{{ quoteToken }}" />

      <section class="servesync-checkout-section" aria-labelledby="customer-info-title">
        <h2 id="customer-info-title">Customer and fulfillment information</h2>
        <div class="servesync-checkout-fields">
          <label class="servesync-form-field">Customer name
            <input type="text" name="customerName" value="{{ form.customerName }}" maxlength="150" autocomplete="name" required />
          </label>
          <label class="servesync-form-field">Contact number
            <input type="tel" name="phone" value="{{ form.phone }}" maxlength="30" autocomplete="tel" required />
          </label>
        </div>

        <fieldset class="servesync-order-type">
          <legend>Delivery or pickup</legend>
          <label class="servesync-payment-option">
            <input type="radio" name="orderType" value="delivery" {{#if form.isDelivery}}checked{{/if}} required />
            <span>Delivery</span>
          </label>
          <label class="servesync-payment-option">
            <input type="radio" name="orderType" value="pickup" {{#if form.isPickup}}checked{{/if}} required />
            <span>Pickup</span>
          </label>
          <label class="servesync-form-field">Delivery address (required for delivery)
            <textarea class="servesync-textarea" name="deliveryAddress" maxlength="500" autocomplete="street-address">{{ form.deliveryAddress }}</textarea>
          </label>
          <p class="servesync-muted">For pickup: {{ pickupInstructions }}</p>
        </fieldset>
      </section>

      <section class="servesync-checkout-section" aria-labelledby="gcash-title">
        <h2 id="gcash-title">Pay with GCash</h2>
        {{#if gcashConfigured}}
          <dl class="servesync-gcash-details">
            <div><dt>Account name</dt><dd>{{ gcashAccountName }}</dd></div>
            <div><dt>GCash number</dt><dd>{{ gcashNumber }}</dd></div>
          </dl>
          {{#if gcashQrImage}}
            <img class="servesync-gcash-qr" src="{{ gcashQrImage }}" alt="ServeSync GCash payment QR code" />
          {{/if}}
          <p class="servesync-muted">{{ gcashInstructions }}</p>
          <p class="servesync-gcash-amount">Send exactly <strong>&#8369;{{ total }}</strong>.</p>
          <label class="servesync-form-field">GCash transaction reference number
            <input type="text" name="referenceCode" value="{{ form.referenceCode }}" minlength="6" maxlength="40" pattern="[A-Za-z0-9-]{6,40}" autocomplete="off" required />
          </label>
        {{else}}
          <p class="servesync-form-error" role="alert">GCash is not configured yet. The restaurant must set its account name and number before customers can place orders.</p>
        {{/if}}
      </section>

      <section class="servesync-checkout-section" aria-labelledby="terms-title">
        <h2 id="terms-title">Terms and conditions</h2>
        <div class="servesync-terms">
          <p>By placing this order, you confirm that the contact, delivery or pickup, items, quantities, and total shown above are correct.</p>
          <p>GCash payment must be sent to the displayed ServeSync account. Submitting a reference number records your payment claim only; it is not proof of payment or confirmation that funds have been received. ServeSync staff will verify the transaction manually. Your order and payment remain pending until reviewed.</p>
          <p>Order preparation or fulfillment is subject to ServeSync confirming availability and payment. Contact the restaurant if you need to change or cancel an order.</p>
        </div>
        <label class="servesync-checkout-checkbox">
          <input type="checkbox" name="termsAccepted" {{#if form.termsAccepted}}checked{{/if}} required />
          <span>I have read and agree to the terms and conditions.</span>
        </label>
        <label class="servesync-checkout-checkbox">
          <input type="checkbox" name="orderConfirmed" {{#if form.orderConfirmed}}checked{{/if}} required />
          <span>I confirm that the order information above is correct.</span>
        </label>
      </section>

      <div class="servesync-checkout-actions">
        <a class="servesync-button servesync-button-ghost" href="/cart">Back to cart</a>
        {{#if available}}
          {{#if gcashConfigured}}
            <button class="servesync-button servesync-button-primary" type="submit">Place Order</button>
          {{else}}
            <button class="servesync-button servesync-button-primary" type="button" disabled>Place Order</button>
          {{/if}}
        {{else}}
          <button class="servesync-button servesync-button-primary" type="button" disabled>Place Order</button>
        {{/if}}
      </div>
    </form>
  </main>
  {{> footer }}
